# The Opportunity Link-up \u2014 Environment variables example
# Copy this file to ".env.local" and fill in your real values.
# NEVER commit .env.local to git.

# ---- Supabase (database + auth + image storage) ----
# Get these from https://supabase.com -> your project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ---- Site config ----
NEXT_PUBLIC_SITE_URL=https://opportunitylinkup.com
NEXT_PUBLIC_SITE_NAME=The Opportunity Link-up
NEXT_PUBLIC_WHATSAPP_INVITE=https://chat.whatsapp.com/your-invite-code

# ---- Google AdSense (activate after approval) ----
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# ---- Newsletter (optional - Resend.com for emails) ----
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=hello@opportunitylinkup.com

# ---- AI Assistant (V2 - OpenAI for opportunity lead finder) ----
OPENAI_API_KEY=

# ---- Donations (optional - Stripe / Paystack / Flutterwave keys for V2) ----
STRIPE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
